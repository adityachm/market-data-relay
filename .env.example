# Upstox OAuth and automated login credentials. Never commit the real file.
API_KEY=replace_with_your_api_key
API_SECRET=replace_with_your_api_secret
REDIRECT_URI=http://127.0.0.1:8765/callback
MOBILE_NO=replace_with_your_mobile_number
PIN=replace_with_your_pin
TOTP_SECRET=replace_with_your_totp_secret

# One instrument for the initial connection test.
UPSTOX_INSTRUMENT_KEY=NSE_INDEX|Nifty 50

# Supported values: ltpc, full, option_greeks, full_d30
UPSTOX_FEED_MODE=ltpc

# Stop after this many decoded messages. Use 0 to stream until interrupted.
UPSTOX_MAX_MESSAGES=0
UPSTOX_LOG_LEVEL=INFO
